```scss
// VARIABLES
$bg-color: #f5f5f5;
$box-color: #dcdcdc;
$text-color: #333;
$accent-color: #888;

$spacing: 20px;
$radius: 10px;

// MIXINS
@mixin flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

@mixin box-style {
  background: $box-color;
  border-radius: $radius;
  padding: $spacing;
}

// RESET
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background: $bg-color;
  color: $text-color;
  font-family: Arial, sans-serif;
  line-height: 1.6;
  padding: 40px;
}

// CONTAINER
.container {
  max-width: 1200px;
  margin: auto;
}

// HEADER
.header {
  @include box-style;
  margin-bottom: $spacing;

  h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }

  p {
    color: $accent-color;
  }
}

// NAVIGATION
.nav {
  @include box-style;
  margin-bottom: $spacing;

  ul {
    list-style: none;
    display: flex;
    gap: 20px;
  }

  a {
    text-decoration: none;
    color: $text-color;
    font-weight: bold;

    &:hover {
      color: black;
    }
  }
}

// MAIN GRID
.main-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: $spacing;

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
  }
}

// CONTENT
.content {
  @include box-style;

  .article {
    margin-bottom: $spacing;

    h2 {
      margin-bottom: 10px;
    }

    .image-placeholder {
      height: 200px;
      background: #bdbdbd;
      border-radius: $radius;
      margin: 15px 0;
    }

    p {
      margin-bottom: 10px;
    }
  }
}

// SIDEBAR
.sidebar {
  @include box-style;

  .widget {
    background: lighten($box-color, 5%);
    padding: 15px;
    border-radius: $radius;
    margin-bottom: 15px;

    h3 {
      margin-bottom: 10px;
    }
  }
}

// BUTTON
.button {
  display: inline-block;
  padding: 12px 24px;
  background: $accent-color;
  color: white;
  border-radius: $radius;
  text-decoration: none;
  transition: 0.3s;

  &:hover {
    background: darken($accent-color, 15%);
  }
}

// FOOTER
.footer {
  @include flex-center;
  @include box-style;

  margin-top: $spacing;
  height: 100px;
  color: $accent-color;
}
```
